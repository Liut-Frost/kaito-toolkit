//@version=6
indicator("Kaito Toolkit - Module 01 : Time Engine", overlay = true, max_lines_count = 500, max_labels_count = 500)

//=====================================================
// KAITO TOOLKIT
// MODULE 01 : TIME ENGINE
//=====================================================
//
// Responsibilities
// • Detect New York calendar events
// • Draw trading day separators
// • Display day labels
// • Display month labels
//
//=====================================================


//=====================================================
// VISIBILITY SETTINGS
//=====================================================

showTimeEngine = input.bool(true, "Enable", group="01. Time Engine")

showMonths = input.bool(true, "Months", group="01. Time Engine")

showWeeks = input.bool(true, "Weeks", group="01. Time Engine")

showDays = input.bool(true, "Days", group="01. Time Engine")

showSessions = input.bool(true, "Sessions", group="01. Time Engine")


//=====================================================
//=====================================================
// MODULE 09 : DISPLAY
//=====================================================

annotationLength = input.int(
     defval = 20,
     title = "Annotation Length",
     minval = 5,
     maxval = 500,
     group = "09. Display")
// NEW YORK CALENDAR
//=====================================================

nyDay       = dayofmonth(time, "America/New_York")
nyPrevDay   = dayofmonth(time[1], "America/New_York")

nyWeekDay   = dayofweek(time, "America/New_York")

nyMonth     = month(time, "America/New_York")
nyPrevMonth = month(time[1], "America/New_York")

nyYear      = year(time, "America/New_York")


//=====================================================
// CALENDAR EVENTS
//=====================================================

isNewDay   = nyDay != nyPrevDay
isNewMonth = nyMonth != nyPrevMonth

isTradingDay =
     nyWeekDay >= dayofweek.monday and
     nyWeekDay <= dayofweek.friday


//=====================================================
// DAY NAME
//=====================================================

string dayName =
     nyWeekDay == dayofweek.monday    ? "Mon" :
     nyWeekDay == dayofweek.tuesday   ? "Tue" :
     nyWeekDay == dayofweek.wednesday ? "Wed" :
     nyWeekDay == dayofweek.thursday  ? "Thu" :
     nyWeekDay == dayofweek.friday    ? "Fri" :
     ""


//=====================================================
// MONTH NAME
//=====================================================

string monthName =
     nyMonth == 1  ? "Jan" :
     nyMonth == 2  ? "Feb" :
     nyMonth == 3  ? "Mar" :
     nyMonth == 4  ? "Apr" :
     nyMonth == 5  ? "May" :
     nyMonth == 6  ? "Jun" :
     nyMonth == 7  ? "Jul" :
     nyMonth == 8  ? "Aug" :
     nyMonth == 9  ? "Sep" :
     nyMonth == 10 ? "Oct" :
     nyMonth == 11 ? "Nov" :
     "Dec"


//=====================================================
// APPEARANCE
//=====================================================

lineColor =
     nyWeekDay == dayofweek.monday ?
     color.blue :
     color.red

lineWidth =
     nyWeekDay == dayofweek.monday ?
     2 :
     1


//=====================================================
// DRAW DAY SEPARATORS
//=====================================================

if showTimeEngine and showDays and isNewDay and isTradingDay

    line.new(
         x1 = bar_index,
         y1 = low - 100000,
         x2 = bar_index,
         y2 = high + 100000,
         xloc = xloc.bar_time,
         extend = extend.none,
         color = lineColor,
         width = lineWidth)

    label.new(
         x = bar_index,
         y = high + (high - low) * 2,
         text = dayName,
         style = label.style_none,
         textcolor = lineColor,
         size = size.normal)


//=====================================================
// DRAW MONTH LABEL
//=====================================================

if showTimeEngine and showMonths and isNewMonth

    label.new(
         x = bar_index,
         y = high + (high - low) * 4,
         text = monthName + " " + str.tostring(nyYear),
         style = label.style_none,
         textcolor = color.yellow,
         size = size.large)
         //=====================================================
// MODULE 02 : DAILY RANGE ENGINE
//=====================================================
//
// Responsibility
// • Track Current Day High/Low
// • Archive Previous Day High/Low
//
// Dependencies
// • Module 01 : Time Engine
//   Requires:
//      isNewDay
//
//=====================================================

//=====================================================
// STATE VARIABLES
//=====================================================

var float currentDayHigh = na
var float currentDayLow  = na

var float previousDayHigh = na
var float previousDayLow  = na

// Origin bars
var int currentDayHighTime = na
var int currentDayLowTime  = na

var int previousDayHighTime = na
var int previousDayLowTime  = na
//=====================================================
//=====================================================
// MODULE 02.1 : LIQUIDITY OBJECT STORAGE
//=====================================================

// Prices
var array<float> liquidityPrices = array.new_float()

// Origin Time
var array<int> liquidityTimes = array.new_int()

// Direction
// 1 = High
// -1 = Low
var array<int> liquidityType = array.new_int()

// Active
var array<bool> liquidityActive = array.new_bool()

// Line IDs
var array<line> liquidityLines = array.new_line()
// INITIALIZATION
//=====================================================

if na(currentDayHigh)
    currentDayHigh := high
    currentDayLow := low

    currentDayHighTime := time
    currentDayLowTime := time

//=====================================================
// NEW TRADING DAY
//=====================================================

if isNewDay

    // Archive completed trading day
    previousDayHigh := currentDayHigh
    previousDayLow := currentDayLow

    previousDayHighTime := currentDayHighTime
    previousDayLowTime := currentDayLowTime

    // Start new trading day
    currentDayHigh := high
    currentDayLow := low

    currentDayHighTime := time
    currentDayLowTime := time
//=====================================================
// UPDATE CURRENT DAY
//=====================================================

// New High
if high > currentDayHigh
    currentDayHigh := high
    currentDayHighTime := time

// New Low
if low < currentDayLow
    currentDayLow := low
    currentDayLowTime := time
//=====================================================
// MODULE 02.1 : DAILY LIQUIDITY RENDERER
//=====================================================
//
// Responsibility
// • Draw PDH
// • Draw PDL
//
// Dependencies
// • previousDayHigh
// • previousDayLow
//=====================================================

//=====================================================
// VISIBILITY
//=====================================================

showDailyRange = input.bool(true, "Enable", group="02. Daily Range")
showPDH = input.bool(true, "PDH", group="02. Daily Range")
showPDL = input.bool(true, "PDL", group="02. Daily Range")

//=====================================================
// OBJECTS
//=====================================================

var line pdhRay = na
var line pdlRay = na

//=====================================================
// CREATE NEW RAYS
//=====================================================

if isNewDay

    if not na(pdhRay)
        line.delete(pdhRay)

    if not na(pdlRay)
        line.delete(pdlRay)

    if showDailyRange and showPDH and not na(previousDayHigh)

        pdhRay := line.new(
     x1 = previousDayHighTime,
     y1 = previousDayHigh,
     x2 = previousDayHighTime + (annotationLength * timeframe.in_seconds() * 1000),
     y2 = previousDayHigh,
     xloc = xloc.bar_time,
     extend = extend.none,
     color = color.green,
     width = 2)

    if showDailyRange and showPDL and not na(previousDayLow)

        pdlRay := line.new(
     x1 = previousDayLowTime,
     y1 = previousDayLow,
     x2 = previousDayLowTime + (annotationLength * timeframe.in_seconds() * 1000),
     y2 = previousDayLow,
     xloc = xloc.bar_time,
     extend = extend.none,
     color = color.red,
     width = 2)