{
  "twelvedata_api_key": "YOUR_TWELVEDATA_API_KEY",
  "telegram_bot_token": "YOUR_TELEGRAM_BOT_TOKEN",
  "telegram_chat_id": "YOUR_TELEGRAM_CHAT_ID",

  "symbols": {
    "EURUSD": "EUR/USD",
    "GBPUSD": "GBP/USD",
    "DXY": "DXY"
  },

  "use_synthetic_dxy": true,
  "synthetic_dxy_components": {
    "EURUSD": "EUR/USD",
    "USDJPY": "USD/JPY",
    "GBPUSD": "GBP/USD",
    "USDCAD": "USD/CAD",
    "USDSEK": "USD/SEK",
    "USDCHF": "USD/CHF"
  },

  "timeframes": {
    "monthly": "1month",
    "weekly": "1week",
    "daily": "1day",
    "h4": "4h",
    "m15": "15min"
  },

  "min_rr": 3.0,
  "poll_seconds": 900,
  "heartbeat_seconds": 14400,
  "api_delay_seconds": 8.0,
  "display_timezone": "America/New_York",

  "require_killzone": true,
  "killzones": {
    "london_open": {
      "name": "London Open",
      "start": "02:00",
      "end": "05:00",
      "enabled": true
    },
    "new_york_open": {
      "name": "New York Open",
      "start": "07:00",
      "end": "10:00",
      "enabled": true
    },
    "london_close": {
      "name": "London Close",
      "start": "10:00",
      "end": "12:00",
      "enabled": true
    },
    "silver_bullet_am": {
      "name": "Silver Bullet (AM)",
      "start": "10:00",
      "end": "11:00",
      "enabled": true
    },
    "silver_bullet_pm": {
      "name": "Silver Bullet (PM)",
      "start": "14:00",
      "end": "15:00",
      "enabled": true
    },
    "asian_session": {
      "name": "Asian Session",
      "start": "20:00",
      "end": "23:59",
      "enabled": false
    }
  },

  "equal_tolerance_pips": 0.0005,
  "sl_buffer_pips": 0.0004
}
